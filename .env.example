APP_NAME="Pemira API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database: MongoDB Atlas ---
# Ganti USER, PASS, dan CLUSTER sesuai kredensial Atlas Anda.
# Password yang mengandung karakter khusus harus di-URL-encode.
DB_CONNECTION=mongodb
MONGODB_URI="mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE=pemira

# --- JWT ---
# Buat nilai acak panjang, contoh: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL=7200

# --- Frontend yang diizinkan mengakses API ---
FRONTEND_URL=http://localhost:5173

# API tidak memakai session, jadi driver file sudah cukup.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
